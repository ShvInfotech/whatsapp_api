# Server Port
PORT=3000

# Optional API Security Key (Leave blank to disable authentication for local testing)
# When set, clients must pass this key in the 'x-api-key' header
API_KEY=

# Local Session ID for LocalAuth
SESSION_ID=safevault-session

# Anti-Ban Rate Limiting Delays (Milliseconds between consecutive bulk messages)
RATE_LIMIT_MIN_DELAY_MS=2500
RATE_LIMIT_MAX_DELAY_MS=4500

# Headless mode for Puppeteer browser (true/false)
HEADLESS=true

# Optional: Path to Chrome executable (auto-detected if omitted)
# CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

